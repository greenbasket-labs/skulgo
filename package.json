{
  "name": "skulgo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "e2e": "playwright test",
    "db:push:prod": "prisma db push --schema prisma/schema.production.prisma --accept-data-loss",
    "build:prod": "npm install --include=dev && npm run postinstall && npm run db:push:prod && next build",
    "postinstall": "prisma generate --schema prisma/schema.production.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.15.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "prisma": "^6.15.0",
    "typescript": "^5.8.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@playwright/test": "^1.63.0",
    "resend": "^6.0.0"
  },
  "devDependencies": {}
}
