generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
  PARENT
  CASHIER
}

enum RequestType {
  JOB
  ADMISSION
}


enum SubscriptionPlan {
  MONTHLY
  TERM
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  TRIAL
}

model School {
  id String @id @default(cuid())
  name String
  abbr String
  address String
  phone String
  email String
  createdAt DateTime @default(now())
  sections Section[]
  classes SchoolClass[]
  subjects Subject[]
  students Student[]
  attendance Attendance[]
  assessments Assessment[]
  results Result[]
  feeRecords FeeRecord[]
  feeDefinitions FeeDefinition[]
  payments Payment[]
  paymentProviders PaymentProvider[]
  assignments TeacherAssignment[]
  classTeacherAssignments ClassTeacher[]
  requests SchoolRequest[]
  memberships SchoolMembership[]
  subscription SchoolSubscription?
  manualPaymentsEnabled Boolean @default(true)
  announcements Announcement[]
  auditLogs AuditLog[]
  classSubjects ClassSubject[]
}

model SchoolSubscription {
  id String @id @default(cuid())
  schoolId String @unique
  school School @relation(fields:[schoolId],references:[id],onDelete:Cascade)
  plan SubscriptionPlan
  status SubscriptionStatus @default(TRIAL)
  startedAt DateTime @default(now())
  expiresAt DateTime?
  createdAt DateTime @default(now())
}

model User {
  id String @id @default(cuid())
  name String
  email String @unique
  passwordHash String
  teacher Teacher?
  student Student?
  parent Parent?
  createdAt DateTime @default(now())
  requests SchoolRequest[]
  memberships SchoolMembership[]
  auditLogs AuditLog[] @relation("AuditActor")
}

model SchoolMembership {
  id String @id @default(cuid())
  schoolId String
  school School @relation(fields:[schoolId],references:[id],onDelete:Cascade)
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  role Role
  active Boolean @default(true)
  createdAt DateTime @default(now())
  @@unique([schoolId,userId])
  @@index([userId,active])
}

model SchoolRequest {
  id String @id @default(cuid())
  schoolId String
  school School @relation(fields:[schoolId],references:[id],onDelete:Cascade)
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  type RequestType
  requestedRole Role
  classId String?
  class SchoolClass? @relation(fields:[classId],references:[id],onDelete:SetNull)
  studentAdmissionId String?
  status String @default("PENDING")
  createdAt DateTime @default(now())
  reviewedAt DateTime?
  applicationDetails String?
  @@index([schoolId,status])
  @@unique([schoolId,userId,type])
}

model Section {
  id String @id @default(cuid())
  schoolId String
  school School @relation(fields:[schoolId],references:[id],onDelete:Cascade)
  name String
  classes SchoolClass[]
  feeDefinitions FeeDefinition[] @relation("FeeDefinitionSection")
  @@unique([schoolId,name])
}

model SchoolClass {
  id String @id @default(cuid())
  schoolId String
  school School @relation(fields:[schoolId],references:[id],onDelete:Cascade)
  sectionId String
  section Section @relation(fields:[sectionId],references:[id],onDelete:Cascade)
  name String
  arm String?
  students Student[]
  assignments TeacherAssignment[]
  attendance Attendance[]
  assessments Assessment[]
  requests SchoolRequest[]
  classSubjects ClassSubject[]
  classTeacherAssignments ClassTeacher[]
  feeDefinitions FeeDefinition[] @relation("FeeDefinitionClass")
  @@unique([schoolId,name,arm])
}

model Subject {
  id String @id @default(cuid())
  schoolId String
  school School @relation(fields:[schoolId],references:[id],onDelete:Cascade)
  name String
  assignments TeacherAssignment[]
  assessments Assessment[]
  results Result[]
  classSubjects ClassSubject[]
  @@unique([schoolId,name])
}

model ClassSubject {
  id String @id @default(cuid())
  schoolId String
  school School @relation(fields:[schoolId],references:[id],onDelete:Cascade)
  classId String
  class SchoolClass @relation(fields:[classId],references:[id],onDelete:Cascade)
  subjectId String
  subject Subject @relation(fields:[subjectId],references:[id],onDelete:Cascade)
  createdAt DateTime @default(now())
  @@unique([classId,subjectId])
  @@index([schoolId,classId])
}

model Teacher {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  teacherCode String @unique
  approved Boolean @default(false)
  assignments TeacherAssignment[]
  classTeacherAssignments ClassTeacher[]
}

model Student {
  id String @id @default(cuid())
  schoolId String
  school School @relation(fields:[schoolId],references:[id],onDelete:Cascade)
  userId String? @unique
  user User? @relation(fields:[userId],references:[id],onDelete:Cascade)
  admissionId String @unique
  firstName String
  lastName String
  gender String?
  classId String?
  class SchoolClass? @relation(fields:[classId],references:[id],onDelete:SetNull)
  parentLinks ParentStudent[]
  attendance Attendance[]
  assessments Assessment[]
  results Result[]
  feeRecords FeeRecord[]
  payments Payment[]
}

model Parent {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  links ParentStudent[]
}

model ParentStudent {
  id String @id @default(cuid())
  parentId String
  parent Parent @relation(fields:[parentId],references:[id],onDelete:Cascade)
  studentId String
  student Student @relation(fields:[studentId],references:[id],onDelete:Cascade)
  approved Boolean @default(false)
  @@unique([parentId,studentId])
}

model TeacherAssignment {
  id String @id @default(cuid())
  schoolId String
  school School @relation(fields:[schoolId],references:[id],onDelete:Cascade)
  teacherId String
  teacher Teacher @relation(fields:[teacherId],references:[id],onDelete:Cascade)
  classId String
  class SchoolClass @relation(fields:[classId],references:[id],onDelete:Cascade)
  subjectId String
  subject Subject @relation(fields:[subjectId],references:[id],onDelete:Cascade)
  @@unique([teacherId,classId,subjectId])
}

model Attendance {
  id String @id @default(cuid())
  schoolId String
  school School @relation(fields:[schoolId],references:[id],onDelete:Cascade)
  studentId String
  student Student @relation(fields:[studentId],references:[id],onDelete:Cascade)
  classId String
  class SchoolClass @relation(fields:[classId],references:[id],onDelete:Cascade)
  date DateTime
  session String
  present Boolean
  @@unique([studentId,date,session])
}

model Assessment {
  id String @id @default(cuid())
  schoolId String
  school School @relation(fields:[schoolId],references:[id],onDelete:Cascade)
  studentId String
  student Student @relation(fields:[studentId],references:[id],onDelete:Cascade)
  classId String
  class SchoolClass @relation(fields:[classId],references:[id],onDelete:Cascade)
  subjectId String
  subject Subject @relation(fields:[subjectId],references:[id],onDelete:Cascade)
  term String
  ca Float
  exam Float
  @@unique([studentId,subjectId,term])
}

model Result {
  id String @id @default(cuid())
  schoolId String
  school School @relation(fields:[schoolId],references:[id],onDelete:Cascade)
  studentId String
  student Student @relation(fields:[studentId],references:[id],onDelete:Cascade)
  subjectId String
  subject Subject @relation(fields:[subjectId],references:[id],onDelete:Cascade)
  term String
  total Float
  percentage Float
  grade String
  position Int
  published Boolean @default(false)
  @@unique([studentId,subjectId,term])
}

model FeeDefinition {
  id String @id @default(cuid())
  schoolId String
  school School @relation(fields:[schoolId],references:[id],onDelete:Cascade)
  title String
  body String?
  amount Float
  targetType String
  sectionId String?
  section Section? @relation("FeeDefinitionSection",fields:[sectionId],references:[id],onDelete:SetNull)
  classId String?
  class SchoolClass? @relation("FeeDefinitionClass",fields:[classId],references:[id],onDelete:SetNull)
  status String @default("DRAFT")
  createdById String
  createdAt DateTime @default(now())
  approvedAt DateTime?
  @@index([schoolId,status])
  @@index([schoolId,targetType])
}

model FeeRecord {
  id String @id @default(cuid())
  schoolId String
  school School @relation(fields:[schoolId],references:[id],onDelete:Cascade)
  studentId String
  student Student @relation(fields:[studentId],references:[id],onDelete:Cascade)
  totalFee Float
  @@unique([studentId])
}

model Payment {
  id String @id @default(cuid())
  schoolId String
  school School @relation(fields:[schoolId],references:[id],onDelete:Cascade)
  studentId String
  student Student @relation(fields:[studentId],references:[id],onDelete:Cascade)
  amount Float
  reference String? @unique
  paidAt DateTime @default(now())
  recordedById String
}

model PaymentProvider {
  id String @id @default(cuid())
  schoolId String
  school School @relation(fields:[schoolId],references:[id],onDelete:Cascade)
  provider String
  enabled Boolean @default(false)
  status String @default("UNVERIFIED")
  accountName String?
  accountNumberLast4 String?
  merchantReference String?
  verifiedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([schoolId,provider])
  @@index([schoolId,enabled])
  @@index([schoolId,status])
}

model Announcement {
  id String @id @default(cuid())
  schoolId String
  school School @relation(fields:[schoolId],references:[id],onDelete:Cascade)
  title String
  body String
  createdById String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([schoolId,createdAt])
}

model AuditLog {
  id String @id @default(cuid())
  schoolId String
  school School @relation(fields:[schoolId],references:[id],onDelete:Cascade)
  actorUserId String
  actor User @relation("AuditActor",fields:[actorUserId],references:[id],onDelete:Cascade)
  action String
  entity String
  entityId String
  details String?
  createdAt DateTime @default(now())
  @@index([schoolId,createdAt])
  @@index([schoolId,entity,entityId])
}

model ClassTeacher {
  id String @id @default(cuid())
  schoolId String
  school School @relation(fields:[schoolId],references:[id],onDelete:Cascade)
  classId String @unique
  class SchoolClass @relation(fields:[classId],references:[id],onDelete:Cascade)
  teacherId String
  teacher Teacher @relation(fields:[teacherId],references:[id],onDelete:Cascade)
  createdAt DateTime @default(now())
}